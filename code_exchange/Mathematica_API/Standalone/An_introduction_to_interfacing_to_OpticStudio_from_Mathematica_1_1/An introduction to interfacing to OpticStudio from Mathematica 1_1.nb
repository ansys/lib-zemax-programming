Cell[BoxData[
 RowBox[{
  RowBox[{
  "LoadNETType", "[", "\"\<ZOSAPI.Tools.Optimization.OptimizationCycles\>\"", 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.771702666924817*^9, 3.771702735691417*^9}, {
   3.7717028821892185`*^9, 3.7717028867904186`*^9}, 3.771702986490819*^9},
