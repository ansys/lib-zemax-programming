Cell["\<\
The OK button method is part of the CommonSettings of all wizards available \
in OpticStudio.\
\>", "Text",
 CellChangeTimes->{{3.7715148603673644`*^9, 
  3.7715148627385645`*^9}},ExpressionUUID->"8f5a53db-a2fa-416b-afb8-\
e01f69922a9a"],

Cell["\<\
Since the lens is before the stop, we cannot use a F/# solve. We don\
\[CloseCurlyQuote]t know which ray is the marginal ray until it has hit the \
edge of the stop. This means we must use the EFFL operand in addition to the \
RMS spot default merit function. Just add an extra line at the top, target \
the EFL to 400mm. Remember to add a weight of 1.\
\>", "Text",
 CellChangeTimes->{{3.7715148770441647`*^9, 
  3.7715148785729647`*^9}},ExpressionUUID->"2ae45ae6-eef3-4586-893a-\
615b4ca40de1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"operand1", "=", 
   RowBox[{"theMFE", "@", 
    RowBox[{"InsertNewOperandAt", "[", "1", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7715150785507655`*^9, 3.7715151177995663`*^9}, {
  3.771515152182366*^9, 3.7715151987943664`*^9}, {3.7715152943135667`*^9, 
  3.771515301894967*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"a4298320-d24c-4591-8608-38b43e4274aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"load", " ", "and", " ", "use", " ", "the", " ", "enumeration"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"meritOperandTypes", "=", 
     RowBox[{
     "LoadNETType", "[", "\"\<ZOSAPI.Editors.MFE.MeritOperandType\>\"", 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"operand1", "@", 
     RowBox[{"ChangeType", "[", "MeritOperandType`EFFL", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.771589404120001*^9, 3.7715894697208014`*^9}, {
   3.7715895350378017`*^9, 3.7715895439118013`*^9}, {3.7715925657760196`*^9, 
   3.77159261875562*^9}, {3.7715933608996243`*^9, 3.7715934247808247`*^9}, 
   3.771593455429825*^9, 3.7715970913820467`*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"de381a63-353f-49fd-b398-323e1ce806fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"operand1", "@", "Target"}], "=", "400.0"}], ";"}]], "Input",
 CellChangeTimes->{{3.77151596837877*^9, 3.7715159897663703`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"8a6ca2d7-f3af-4982-815e-99558a4c5d64"],

Cell[BoxData[
 RowBox[{
