Cell[BoxData[
 RowBox[{
  RowBox[{
  "LoadNETType", "[", 
   "\"\<ZOSAPI.Tools.Optimization.OptimizationAlgorithm\>\"", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.771702666924817*^9, 3.771702735691417*^9}, 
   3.771702979596419*^9},
 CellLabel->"In[73]:=",ExpressionUUID->"dcf0907f-a78f-49e7-a4b1-4d3da0830aad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"localOpt", "@", "Algorithm"}], "=", 
   "OptimizationAlgorithm`DampedLeastSquares"}], ";"}]], "Input",
 CellChangeTimes->{{3.7715170440845747`*^9, 3.771517090634775*^9}, {
   3.771517122006575*^9, 3.7715172149819756`*^9}, 3.77151792576958*^9, 
