Cell[CellGroupData[{

Cell["\<\
We can make use of one of the constants using the Mathematica context syntax\
\>", "Subsection",
 CellChangeTimes->{{3.7715914753154135`*^9, 3.7715915300726137`*^9}, {
  3.7717010185380073`*^9, 
  3.771701023158207*^9}},ExpressionUUID->"6d98c290-5cc4-455e-872f-\
88315da49372"],

Cell["\<\
Notice the use of the context mark, and that the \[OpenCurlyDoubleQuote]_\
\[CloseCurlyDoubleQuote]  in the name must be replaced with  \
\[OpenCurlyDoubleQuote]U.\[CloseCurlyDoubleQuote]\
\>", "Text",
 CellChangeTimes->{{3.7715915816126137`*^9, 3.771591642907814*^9}, {
   3.7715918962356157`*^9, 3.7715919166576157`*^9}, 3.7715969115310454`*^9, {
