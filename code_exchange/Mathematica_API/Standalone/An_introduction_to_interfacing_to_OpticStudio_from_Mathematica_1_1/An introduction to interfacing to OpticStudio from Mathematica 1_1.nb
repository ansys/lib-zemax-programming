 CellLabel->"In[15]:=",ExpressionUUID->"78a2d978-a986-4a38-ba2c-7590f6fdc8e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ZOSAPIUInitializer`Initialize", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.636379943098374*^9, 3.636379988525654*^9}, {
   3.636380653040021*^9, 3.6363806538980227`*^9}, 3.771520473627783*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"e7c183af-171d-4b41-b1fd-c47192b217c7"]
}, Open  ]],

