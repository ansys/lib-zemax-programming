   RowBox[{"operand1", "@", "Weight"}], "=", "1.0"}], ";"}]], "Input",
 CellChangeTimes->{{3.7715159969573703`*^9, 3.7715160160157704`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"cb6c444e-3f3b-43f0-8b7d-076a4a23b105"],

