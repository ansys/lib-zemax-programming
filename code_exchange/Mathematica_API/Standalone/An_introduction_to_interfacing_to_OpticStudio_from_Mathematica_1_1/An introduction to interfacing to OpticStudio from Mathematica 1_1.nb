c4fbe2b5bde8"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " retrieves the enum license type as a .NET object. These can be converted \
to enum Integers or to a string."
}], "Text",
 CellChangeTimes->{{3.6380295329536796`*^9, 3.6380295571157136`*^9}, {
   3.6380325268953023`*^9, 3.6380326070454173`*^9}, 3.6380375356693163`*^9, {
