Cell[CellGroupData[{

Cell["Set up the optimizer", "Subsection",
 CellChangeTimes->{{3.7717031173466196`*^9, 
  3.77170312442682*^9}},ExpressionUUID->"b9c2a3b9-ebc6-40cd-9982-\
88a09e73f3bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"localOpt", "=", 
   RowBox[{"theSystem", "@", 
    RowBox[{"Tools", "@", 
     RowBox[{"OpenLocalOptimization", "[", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7715170440845747`*^9, 3.771517090634775*^9}, {
   3.771517122006575*^9, 3.771517187873376*^9}, 3.771520573126783*^9, 
