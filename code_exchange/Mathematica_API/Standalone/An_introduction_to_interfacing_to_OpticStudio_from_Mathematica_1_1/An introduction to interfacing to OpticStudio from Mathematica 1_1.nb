 RowBox[{
  RowBox[{
  "LoadNETType", "[", "\"\<ZOSAPI_NetHelper.ZOSAPI_Initializer\>\"", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.6363793842429924`*^9, 3.6363794935523844`*^9}, {
   3.6363801933540134`*^9, 3.636380218423258*^9}, {3.636380570032275*^9, 
   3.636380575773085*^9}, {3.6369941307254395`*^9, 3.636994132675443*^9}, 
