Cell[CellGroupData[{

Cell[".NET Syntax in Mathematica", "Section",
 CellChangeTimes->{{3.637952306681506*^9, 3.637952313155517*^9}, {
  3.6380354791460686`*^9, 
  3.63803549420809*^9}},ExpressionUUID->"9c5baa3c-02e1-49ea-a6d2-\
63c61532509d"],

Cell[TextData[{
 "The Wolfram Language syntax for calling .NET methods and accessing fields \
is very similar to the syntax used in C# and Visual Basic.NET. The following \
box compares the Wolfram Language and C# ways of calling constructors, \
methods, properties, fields, static methods, static properties, and static \
fields. You can see that Wolfram Language programs that use .NET are written \
in almost exactly the same way as C# (or VB .NET) programs, except the \
Wolfram Language uses [] instead of () for arguments and @ instead of the . \
(dot) as the \"member access\" operator.\n\nAn exception is that for static \
methods the Wolfram Language uses the context mark ",
 Cell[BoxData[
 "`"], "InlineFormula",ExpressionUUID->"70590734-8d56-4894-b99d-61732d27a710"],
 " in place of the dot used by C# and VB. This also parallels the usage in \
those languages, as their use of the dot in this circumstance is really as a \
scope resolution operator (like ",
 StyleBox["::", "InlineCode"],
 " in C++). Although the Wolfram Language does not use this terminology, its \
scope resolution operator is the context mark.  .NET namespace names map \
directly to the Wolfram Language\[CloseCurlyQuote]s hierarchical contexts.\n",
 "\n",
 "Also note that because _ (underscore) is a reserved character in \
Mathematica, NETLink replaces underscores with a capital U.\n"
}], "Text",
 CellChangeTimes->{{3.637952255607016*^9, 3.637952255607016*^9}, {
   3.6379523199571295`*^9, 3.637952346024775*^9}, 3.6379530377705917`*^9, {
   3.6380379354230194`*^9, 3.63803795016504*^9}, {3.771421462424811*^9, 
   3.7714214771798105`*^9}, 3.7714215265246115`*^9, 3.771519866225783*^9, 
   3.7715918692010155`*^9},ExpressionUUID->"e079c487-e974-4ff4-9813-\
f21af619548f"],

Cell[BoxData[GridBox[{
   {" ", Cell[
    "Constructors", "TableHeader",ExpressionUUID->
     "1dc5f926-26ac-4b1f-8a27-4d1025ebec89"]},
   {
    StyleBox[
     RowBox[{
      RowBox[{"C", "#"}], ":"}], "TR"], Cell[
    "MyClass obj = new MyClass(args);", "TableText",ExpressionUUID->
     "a44b9dfa-2c89-4a84-9346-a9ac26d0b16b"]},
   {
    RowBox[{"Wolfram", " ", 
     RowBox[{"Language", 
      StyleBox[":", "TR"]}]}], Cell[
    "obj = NETNew[\"MyClass\", args];", "TableText",ExpressionUUID->
     "4c2fe0d6-37a1-4220-aae0-90bdd8add3c5"]},
   {" ", 
    StyleBox["Methods", "TableHeader"]},
   {
    StyleBox[
     RowBox[{
      RowBox[{"C", "#"}], ":"}], "TR"], Cell[
    "obj.MethodName(args);", "TableText",ExpressionUUID->
     "1f1d4bc8-3e88-4512-a805-65226c68e0ce"]},
   {
    RowBox[{"Wolfram", " ", 
     RowBox[{"Language", 
      StyleBox[":", "TR"]}]}], Cell[
    "obj@MethodName[args]", "TableText",ExpressionUUID->
     "c85b63ea-dc1f-4981-9771-f99d141bbfa8"]},
   {" ", 
    StyleBox[
     RowBox[{"Properties", " ", "and", " ", "fields"}], "TableHeader"]},
   {
    StyleBox[
     RowBox[{
      RowBox[{"C", "#"}], ":"}], "TR"], Cell["\<\
obj.PropertyOrFieldName = 1;
value = obj.PropertyOrFieldName;\
\>", "TableText",ExpressionUUID->"e450a2d9-cd0b-49ea-b828-b26982987821"]},
   {
    RowBox[{"Wolfram", " ", 
     RowBox[{"Language", 
      StyleBox[":", "TR"]}]}], Cell["\<\
obj@PropertyOrFieldName = 1;
value = obj@PropertyOrFieldName;\
\>", "TableText",ExpressionUUID->"0c8b1b15-9cb8-4fb5-a3a7-324dafefefcc"]},
   {" ", 
    StyleBox[
     RowBox[{"Static", " ", "methods"}], "TableHeader"]},
   {
    StyleBox[
     RowBox[{
      RowBox[{"C", "#"}], ":"}], "TR"], Cell[
    "MyClass.StaticMethod(args);", "TableText",ExpressionUUID->
     "343ee36b-15d9-4bd3-85f2-528c26827bca"]},
   {
    RowBox[{"Wolfram", " ", 
     RowBox[{"Language", 
      StyleBox[":", "TR"]}]}], Cell[
    "MyClass`StaticMethod[args];", "TableText",ExpressionUUID->
     "c277bf16-afc1-44d0-afdc-0a3bc85e117f"]},
   {" ", 
    StyleBox[
     RowBox[{"Static", " ", "properties", " ", "and", " ", "fields"}], 
     "TableHeader"]},
   {
    StyleBox[
     RowBox[{
      RowBox[{"C", "#"}], ":"}], "TR"], Cell["\<\
MyClass.StaticPropertyOrField = 1;
value = MyClass.StaticPropertyOrField;\
\>", "TableText",ExpressionUUID->"e7f5ed03-fcca-4c9f-8cbe-83dc05965d3c"]},
   {
    RowBox[{"Wolfram", " ", 
     RowBox[{"Language", 
      StyleBox[":", "TR"]}]}], Cell["\<\
MyClass`StaticPropertyOrField = 1;
value = MyClass`StaticPropertyOrField;\
\>", "TableText",ExpressionUUID->"714e1268-5b9d-46e1-9f08-a524b551a81b"]}
  },
  GridBoxDividers->{
   "Columns" -> {{False}}, "ColumnsIndexed" -> {}, 
    "Rows" -> {
     False, False, False, True, False, False, True, False, False, True, False,
       False, True, {False}, False}, "RowsIndexed" -> {}}]], "Text",
 CellChangeTimes->{3.637952952064041*^9},
 Background->GrayLevel[0.85],
 CellTags->"nlug:3.1.5",
 CellID->17120,ExpressionUUID->"d247dcc7-7fc3-48fb-b38d-aeb232cfc5b7"],

Cell[TextData[{
 "\nFurther information on using .NET/Link, which is the Mathematica .NET \
interface, can be found ",
 ButtonBox["at",
  BaseStyle->"Hyperlink",
  ButtonData->{
   " http://reference.wolfram.com/language/NETLink/tutorial/Overview.html", 
    None}],
 "   http://reference.wolfram.com/language/NETLink/tutorial/Overview.html or \
through the help system of a running Mathematica notebook.\n"
}], "Text",
 CellChangeTimes->{{3.771699980024201*^9, 3.7716999937386007`*^9}, {
  3.7717000405368013`*^9, 3.7717000405368013`*^9}, {3.7717000751998014`*^9, 
