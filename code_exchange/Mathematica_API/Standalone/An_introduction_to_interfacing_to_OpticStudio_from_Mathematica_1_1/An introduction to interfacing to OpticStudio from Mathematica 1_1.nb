Cell[CellGroupData[{

Cell["A quick aside -- Use NETTypeInfo to get information", "Section",
 CellChangeTimes->{{3.6379579514003077`*^9, 3.6379579624607267`*^9}, {
  3.637958008746008*^9, 3.637958026483239*^9}, {3.638039397003307*^9, 
  3.6380394169743347`*^9}, {3.638039772959914*^9, 
  3.6380397735999155`*^9}},ExpressionUUID->"3c06ab72-b32a-4bde-980c-\
5f06cdba993b"],

Cell[TextData[{
 "Here is something very useful:  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " .",
 StyleBox["NET/Link",
  FontSlant->"Italic"],
 " has a function called NETTypeInfo which will allow you to quickly display \
information about the methods, properties, fields, and so on that exist in a \
given .NET type. You can use this function by passing it each new type, as \
you go, on down the structure. The ZOS-API fields, properties, methods, etc, \
are named very logically. You can usually figure out what you can do with an \
object by passing it to NETTypeInfo and reading the results."
}], "Text",
 CellChangeTimes->{{3.6379579788563557`*^9, 3.637958087167346*^9}, {
  3.6379581644186816`*^9, 3.637958165292283*^9}, {3.637958201390746*^9, 
  3.6379582109379635`*^9}, {3.637958245882025*^9, 3.6379584434407716`*^9}, {
  3.63803749514526*^9, 3.638037520678295*^9}, {3.638038156084329*^9, 
  3.638038158444332*^9}, {3.7715032483559027`*^9, 3.771503282082703*^9}, {
  3.771520207118783*^9, 
  3.7715202156287827`*^9}},ExpressionUUID->"80faba64-2bd7-47a0-b3d6-\
47ccc85627a6"],

Cell[CellGroupData[{

Cell["For example ", "Subsection",
 CellChangeTimes->{{3.637958542142145*^9, 3.6379585525941634`*^9}, 
   3.6380355265411353`*^9},ExpressionUUID->"fe107b2a-11f2-4e46-bb3e-\
9d2c903d4207"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NETTypeInfo", "[", "zosapi", "]"}]], "Input",
