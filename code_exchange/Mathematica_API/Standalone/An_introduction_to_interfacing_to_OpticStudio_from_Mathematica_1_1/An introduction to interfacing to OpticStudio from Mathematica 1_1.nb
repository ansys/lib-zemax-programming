  3.636994015815638*^9}},ExpressionUUID->"9ae368ff-ddf7-4518-8b10-\
abe24914468c"],

Cell[TextData[{
 "Following the Zemax documentation on ZOS-API we load the three ZOS-API \
assemblies using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function LoadNETAssembly."
}], "Text",
 CellChangeTimes->{{3.6379538403762245`*^9, 3.6379538517486444`*^9}, {
  3.6379538921839156`*^9, 3.637953964646043*^9}, {3.638038899455529*^9, 
  3.638038908106541*^9}},ExpressionUUID->"c05f01cb-3aef-44a7-8f62-\
9ac53b612398"],

