Cell[CellGroupData[{

Cell["We can directly check if the license is valid for ZOS-API", \
"Subsubsection",
 CellChangeTimes->{{3.7715041318175077`*^9, 3.771504154579508*^9}, {
  3.7715185980467825`*^9, 3.771518599982783*^9}, {3.771701080737608*^9, 
  3.7717010915970078`*^9}},ExpressionUUID->"012487b9-265c-4897-827b-\
674bdd3709bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"abort", " ", "if", " ", "no", " ", "valid", " ", "license"}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", " ", 
     RowBox[{"theApplication", "@", 
      RowBox[{"IsValidLicenseForAPI", "[", "]"}]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "MessageDialog", "[", "\"\<No valid OpticStudio license found\>\"", 
      "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.771504060029707*^9, 3.771504077140107*^9}, {
  3.7717673334460135`*^9, 3.7717674566694145`*^9}, {3.771767587414415*^9, 
  3.771767591343815*^9}, {3.7717676526536155`*^9, 3.771767676848016*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"82c2b62b-3968-45f1-b24a-71c9fd174af0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Create a Primary System and save it as a lens file", "Section",
 CellChangeTimes->{{3.6367454526813526`*^9, 3.6367454620413694`*^9}, {
  3.63682077645592*^9, 3.636820782718279*^9}, {3.636994220269597*^9, 
  3.636994225854407*^9}, {3.771504178494508*^9, 3.771504180148108*^9}, {
  3.7715059348321185`*^9, 3.7715059365481186`*^9}, {3.7715059780593185`*^9, 
  3.771505987262719*^9}},ExpressionUUID->"61d217b2-b3c3-441c-89e1-\
a5ebadbdcc80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"theSystem", "=", 
   RowBox[{"theApplication", "@", 
    RowBox[{"PrimarySystem", "[", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.636381833106625*^9, 3.636381872449894*^9}, 
   3.636746992792736*^9, {3.636820681006461*^9, 3.6368206920690937`*^9}, {
   3.77150449224551*^9, 3.77150449508471*^9}, 3.771506003818319*^9},
 CellLabel->"In[22]:=",ExpressionUUID->"38c26259-3a40-49e2-9a75-6bc88f770008"],

Cell["\<\
The System represents a complete optical system, which corresponds to a \
single .ZMX file. Now create a string containing the file path for the new \
file. To make the script flexible, we will use the SamplesDir property to \
create file path .\
\>", "Text",
 CellChangeTimes->{{3.7715060843767195`*^9, 
  3.77150609576252*^9}},ExpressionUUID->"7abf0a5f-cf45-4abf-8969-\
e86c054659aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "name", " ", "of", " ", "the", " ", "lens", " ", "we", " ", 
