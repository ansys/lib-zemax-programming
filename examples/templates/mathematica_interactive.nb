  3.843919819145729*^9}},ExpressionUUID->"491ee93c-803d-441f-ba12-\
85aa695dee95"],

Cell["\<\
A blank Interactive Extension template for running the ZOS-API\
\>", "Text",
 CellChangeTimes->{{3.8396881291975994`*^9, 3.8396881300308065`*^9}, {
  3.839688228998783*^9, 3.839688243597742*^9}, {3.8439198258378143`*^9, 
  3.8439198312774067`*^9}},ExpressionUUID->"cde5ef46-d218-40ab-af31-\
